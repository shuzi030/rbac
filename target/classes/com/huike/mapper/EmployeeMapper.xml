<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huike.mapper.EmployeeMapper">

    <select id="list" resultType="com.huike.entity.Employee">
        select * from employee where (name like '%${keyword}%' or email like '%${keyword}%')
        <if test="deptId != null and deptId != ''">
            and  dept_id = #{deptId}
        </if>
    </select>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into employee(username,name,password,email,age,dept_id)
        values(#{username},#{name},#{password},#{email},#{age},#{dept.id})
    </insert>
</mapper>