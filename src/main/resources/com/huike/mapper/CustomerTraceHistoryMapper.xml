<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huike.mapper.CustomerTraceHistoryMapper">
    
    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.huike.entity.CustomerTraceHistory">
        <id column="id" property="id" />
        <result column="trace_time" property="traceTime" />
        <result column="trace_details" property="traceDetails" />
        <result column="trace_type_id" property="traceTypeId" />
        <result column="trace_result" property="traceResult" />
        <result column="remark" property="remark" />
        <result column="customer_id" property="customerId" />
        <result column="input_user_id" property="inputUserId" />
        <result column="input_time" property="inputTime" />
        <result column="type" property="type" />
    </resultMap>
    
    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, trace_time, trace_details, trace_type_id, trace_result, remark,
        customer_id, input_user_id, input_time, type
    </sql>
    
    <!-- 根据客户ID查询跟进记录 -->
    <select id="listByCustomerId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM customertracehistory
        WHERE customer_id = #{customerId}
        ORDER BY trace_time DESC, input_time DESC
    </select>
    
    <!-- 分页查询跟进记录 -->
    <select id="list" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM customertracehistory
        <where>
            <if test="keyword != null and keyword != ''">
                AND (trace_details LIKE CONCAT('%', #{keyword}, '%')
                OR remark LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY trace_time DESC, input_time DESC
    </select>
    
    <!-- 根据ID查询跟进记录 -->
    <select id="getById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM customertracehistory
        WHERE id = #{id}
    </select>
    
    <!-- 新增跟进记录 -->
    <insert id="save" parameterType="com.huike.entity.CustomerTraceHistory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customertracehistory (
            trace_time, trace_details, trace_type_id, trace_result, remark,
            customer_id, input_user_id, input_time, type
        ) VALUES (
            #{traceTime}, #{traceDetails}, #{traceTypeId}, #{traceResult}, #{remark},
            #{customerId}, #{inputUserId}, #{inputTime}, #{type}
        )
    </insert>
    
    <!-- 更新跟进记录 -->
    <update id="update" parameterType="com.huike.entity.CustomerTraceHistory">
        UPDATE customertracehistory
        <set>
            <if test="traceTime != null">trace_time = #{traceTime},</if>
            <if test="traceDetails != null">trace_details = #{traceDetails},</if>
            <if test="traceTypeId != null">trace_type_id = #{traceTypeId},</if>
            <if test="traceResult != null">trace_result = #{traceResult},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="type != null">type = #{type},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <!-- 删除跟进记录 -->
    <delete id="delete">
        DELETE FROM customertracehistory WHERE id = #{id}
    </delete>
    
    <!-- 查询最近的跟进记录 -->
    <select id="listRecentByCustomerId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM customertracehistory
        WHERE customer_id = #{customerId}
        ORDER BY trace_time DESC, input_time DESC
        LIMIT #{limit}
    </select>
    
</mapper>
